{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    },
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "include": ["src/**/*", "shared/**/*", "tests/**/*"],
  "exclude": ["tests/integration/**/*"]
}
